# ========================================
# 套利监听机器人配置文件
# 监听模式 - 只监控价格，不执行交易
# ========================================

# ========== 网络配置 ==========
# 主RPC节点 (Arbitrum主网)
RPC_URL=https://arb1.arbitrum.io/rpc

# 备用RPC节点（可选，提高稳定性）
# BACKUP_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY

# ========== 监听参数 ==========
# 模拟套利金额 (USDT)
AMOUNT_USDT=100

# 最小净利润要求 (USDT)
MIN_NET_PROFIT_USDT=0.5

# 滑点容忍度 (基点，100 = 1%)
SLIPPAGE_BPS=50

# Gas价格倍数 (用于估算成本)
GAS_MULTIPLIER=1.2

# ========== 监控配置 ==========
# 扫描间隔 (秒)
SCAN_INTERVAL=1

# 详细日志模式
VERBOSE_LOGGING=true

# 日志文件路径
LOG_FILE_PATH=./logs/arbitrage.log

# 数据文件路径
DATA_FILE_PATH=./data/opportunities.json

# ========== DEX配置 ==========
# Uniswap V3
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
UNISWAP_V3_QUOTER=0x61FFE014BA17989E743C5F6CB21BF9697530B21E
UNISWAP_V3_FEE=3000  # 0.3%

# SushiSwap
SUSHI_ROUTER=0xf2614A233c7C3e7f08b1F887Ba133a13f1eb2c55

# ========== 代币地址 (Arbitrum) ==========
# 稳定币
USDT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
USDC=0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
DAI=0xDA10009cBd5D07dd0CeCc66161FC93D7c9000da1

# 主流币
WETH=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
WBTC=0x2f2a2543B76A4166549F7aaB2e75Bef0aefC5B0f

# ========== 通知配置 (可选) ==========
# Telegram机器人Token（用于发送通知）
# 创建机器人: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram聊天ID
# 获取ID: https://t.me/userinfobot
# TELEGRAM_CHAT_ID=your_chat_id_here

# ========== 安全配置 ==========
# 最大Gas价格限制 (Gwei)
MAX_GAS_PRICE_GWEI=100

# 启用代币白名单检查
ENABLE_TOKEN_WHITELIST=true

# ========================================
# 注意事项：
# 1. 这是监听模式配置，不需要私钥
# 2. 不会执行实际交易，只记录机会
# 3. 所有金额都是模拟值
# 4. 请根据实际需求调整参数
# ========================================