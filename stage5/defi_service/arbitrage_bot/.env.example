# Arbitrage Bot 配置文件模板
# 复制此文件为 .env 并填入实际值

# ========== 网络配置 ==========
# RPC 节点 URL (支持多种网络)
RPC_URL=https://arb1.arbitrum.io/rpc
# 备用 RPC (提高稳定性)
BACKUP_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY

# ========== 账户配置 ==========
# 执行套利的账户地址
ACCOUNT=0xYourAccountAddress
# 账户私钥 (请妥善保管，不要泄露)
PRIVATE_KEY=0xYourPrivateKey

# ========== 合约地址 ==========
# 套利执行器合约地址 (部署后填入)
EXECUTOR=0xYourExecutorContractAddress

# ========== 套利参数 ==========
# 每次套利使用的 USDT 数量 (单位: USDT)
AMOUNT_USDT=100
# 最小净利润要求 (单位: USDT)
MIN_NET_PROFIT_USDT=0.5
# 滑点容忍度 (基点，100 = 1%)
SLIPPAGE_BPS=50
# Gas 价格倍数 (1.2 = 120% 的估算 gas)
GAS_MULTIPLIER=1.2

# ========== 监控配置 ==========
# 扫描间隔 (秒)
SCAN_INTERVAL=1
# 是否启用详细日志
VERBOSE_LOGGING=true
# 日志文件路径
LOG_FILE_PATH=./logs/arbitrage.log

# ========== DEX 配置 ==========
# Uniswap V3
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
UNISWAP_V3_QUOTER=0x61FFE014BA17989E743C5F6CB21BF9697530B21E
UNISWAP_V3_FEE=3000

# Uniswap V2 / SushiSwap
SUSHI_ROUTER=0xf2614A233c7C3e7f08b1F887Ba133a13f1eb2c55
UNISWAP_V2_ROUTER=0x4752ba5dbc23f44d87826276bf6fd6b1c372ad24

# Curve Finance
CURVE_REGISTRY=0x445FE580eF8d70FF569aB36e80c647af338db351
CURVE_3POOL=0x7f90122BF0700F9E7e1F688fe926940E8839F353

# ========== 代币地址 (Arbitrum) ==========
USDT=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
USDC=0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
WETH=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
WBTC=0x2f2a2543B76A4166549F7aaB2e75Bef0aefC5B0f
DAI=0xDA10009cBd5D07dd0CeCc66161FC93D7c9000da1

# ========== 通知配置 (可选) ==========
# Telegram Bot Token (用于发送通知)
TELEGRAM_BOT_TOKEN=
# Telegram Chat ID
TELEGRAM_CHAT_ID=

# ========== 安全配置 ==========
# 最大 Gas 价格限制 (Gwei)
MAX_GAS_PRICE_GWEI=100
# 是否启用白名单代币检查
ENABLE_TOKEN_WHITELIST=true
# 是否启用 MEV 保护
ENABLE_MEV_PROTECTION=false